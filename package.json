{
  "name": "autotask",
  "version": "0.1.0",
  "description": "Terminal queue supervisor and orchestrator for OpenCode CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "autotask": "./dist/cli.js",
    "ocq": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "dev:mock": "tsx src/cli.ts --mock",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "queue",
    "supervisor",
    "orchestrator",
    "terminal",
    "tui",
    "ai-agent",
    "automation"
  ],
  "author": "Autotask Contributors",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
