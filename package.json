{
  "name": "@9matesu/autotask",
  "version": "0.1.1",
  "description": "Terminal queue supervisor and execution orchestrator for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "autotask": "dist/cli.js",
    "ocq": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9matesu/autotask.git"
  },
  "bugs": {
    "url": "https://github.com/9matesu/autotask/issues"
  },
  "homepage": "https://github.com/9matesu/autotask#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "dev:mock": "tsx src/cli.ts --mock",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "release": "npm publish --access public",
    "release:patch": "npm version patch && git push --follow-tags && npm publish --access public",
    "release:minor": "npm version minor && git push --follow-tags && npm publish --access public",
    "release:major": "npm version major && git push --follow-tags && npm publish --access public"
  },
  "keywords": [
    "ai-coding",
    "autonomous-agent",
    "queue",
    "supervisor",
    "orchestrator",
    "terminal",
    "tui",
    "opencode",
    "task-runner"
  ],
  "author": "Autotask Contributors",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
